# Public URL of the live site, without a trailing slash.
# Used for canonical URLs, the sitemap, robots.txt, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# Optional. Endpoint that receives enquiry form submissions as a JSON POST.
# Leave empty to deliver enquiries by WhatsApp instead: the form opens a chat
# with the showroom's number (lib/site.ts) with the enquiry written out.
# If you set this, the privacy policy page updates its wording to match.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
